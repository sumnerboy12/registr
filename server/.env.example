# Copy this file to .env (same folder) and fill in your Entra ID (Azure AD)
# app registration details. registr has no username/password login at all —
# M365 SSO via OpenID Connect is the only way in, for registr's own UI and
# (indirectly) for every app that checks access against registr.
#
# OIDC_ISSUER_URL is the tenant's issuer/authority:
#   https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_REDIRECT_URI must exactly match what's registered with the app
# registration, e.g. https://registr.example.com/api/auth/oidc/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Only an email on this domain can ever be granted app access — matches the
# fact that only waymanroofing.co.nz accounts can complete the SSO flow at
# all. Comma-separate if a second domain is ever needed.
ALLOWED_EMAIL_DOMAIN=waymanroofing.co.nz

# One-time bootstrap: on boot, if no one has registr admin access yet, this
# person is created (if needed) and granted it. Only fires while there are
# zero registr admins — safe to leave set permanently, or blank it out again
# once the first admin is in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
# Optional — also sets a temporary local password for that admin (must be
# changed on first login), so there's a way into registr before SSO is
# configured or if it's ever unavailable. Leave blank to bootstrap via SSO
# only.
SEED_ADMIN_PASSWORD=
