# Set to "development" or "test" on any non-production deployment — the UI
# shows a badge so people can tell they're not on the real server. Leave
# blank (or "production") on the real deployment.
APP_ENV=

# Copy this file to .env and fill in Entra ID (Azure AD) app registration
# details to enable M365 SSO. Leave blank to use only the break-glass admin
# login below.
#
# OIDC_ISSUER_URL: https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_REDIRECT_URI must match the app registration, e.g.
# https://registr.example.com/api/auth/oidc/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Break-glass login (username "admin") for when SSO isn't set up or is
# down. Not tied to any person record. Leave blank to disable.
ADMIN_PASSWORD=

# Optional SMTP account registr relays email through for rostr/claimr/costr
# (POST /api/v1/email/send). Leave blank to disable — nothing else breaks.
SMTP_HOST=
SMTP_PORT=587
# false unless your provider needs SSL on connect (usually port 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if left blank.
SMTP_FROM=
# Optional display name, e.g. "Jesse Wayman".
SMTP_FROM_NAME=
# Optional — where replies should land if different from SMTP_FROM.
SMTP_REPLY_TO=
