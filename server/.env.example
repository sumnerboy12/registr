# Copy this file to .env (same folder) and fill in your Entra ID (Azure AD)
# app registration details. M365 SSO via OpenID Connect is the main way in,
# for registr's own UI and (indirectly) for every app that checks access
# against registr — but a person can also be given a local username/password
# login alongside it (see People > a person > Local login).
#
# OIDC_ISSUER_URL is the tenant's issuer/authority:
#   https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_REDIRECT_URI must exactly match what's registered with the app
# registration, e.g. https://registr.example.com/api/auth/oidc/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
